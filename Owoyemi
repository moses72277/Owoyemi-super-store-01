
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#123d2b">
<title>Owoyemi Super Store Ltd.</title>
<style>
:root{--g:#123d2b;--lime:#d7f36a;--cream:#faf8f0;--muted:#6b756c}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font:15px Arial,sans-serif;background:var(--cream);color:#202820}
header{background:var(--g);color:white;padding:18px 5%;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.logo{font-size:19px;font-weight:bold}.logo span{color:var(--lime)}
nav{display:flex;gap:15px;flex-wrap:wrap;font-size:13px}
a{color:inherit;text-decoration:none}
.hero{background:var(--g);color:white;padding:50px 6%;display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:center}
.hero h1{font-size:clamp(35px,6vw,60px);line-height:1.08;margin:14px 0}
.hero p{color:#d9e5da;line-height:1.7}
.kicker{color:var(--lime);font-size:12px;letter-spacing:2px;font-weight:bold}
.art{border-radius:22px;background:linear-gradient(135deg,#275b40,#081f15);min-height:210px;display:grid;place-items:center;font-size:70px}
.btn{border:0;border-radius:9px;padding:12px 16px;font-weight:bold;cursor:pointer;background:var(--lime);color:var(--g);display:inline-block}
.btn.dark{background:var(--g);color:white}
section{padding:38px 5%}
.heading{text-align:center;margin:0 auto 24px;max-width:650px}
.heading h2{font-size:clamp(26px,4vw,36px);margin:8px 0}
.heading p,.muted{color:var(--muted);line-height:1.6}
.search{display:block;width:100%;padding:14px;border:1px solid #d8ded4;border-radius:10px;font-size:16px;margin:0 0 15px;background:white}
.filters{display:flex;gap:8px;overflow-x:auto;padding:2px 0 15px}
.filter{white-space:nowrap;border:1px solid #d8ded4;background:white;border-radius:24px;padding:10px 13px;cursor:pointer}
.filter.active{background:var(--g);color:white}
.info{padding:12px;border-radius:10px;background:#fff0d8;color:#68491d;font-size:13px;line-height:1.5;margin:0 0 18px}
.count{font-size:13px;color:var(--muted);margin-bottom:13px}
.products{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
.card{background:white;border:1px solid #e5e8df;border-radius:13px;overflow:hidden;display:flex;flex-direction:column;min-width:0}
.pic{background:linear-gradient(135deg,#edf2df,#f9f2e2);min-height:95px;display:grid;place-items:center;font-size:40px}
.details{padding:12px;display:flex;flex-direction:column;flex:1}
.details h3{font-size:15px;line-height:1.35;margin:0 0 6px}
.details p{font-size:12px;color:var(--muted);margin:0 0 10px}
.price{font-weight:bold;color:var(--g);margin-top:auto;padding-bottom:10px}
.qty{width:100%;padding:8px;border:1px solid #d9ded5;border-radius:7px;background:white;margin-bottom:8px}
.details .btn{width:100%;padding:10px 5px;font-size:12px}
.order{background:#eaf0df;border-radius:16px;padding:23px}
.order h2{margin-top:0}
.cartlist{padding-left:20px;line-height:1.8;overflow-wrap:anywhere}
.contact{background:var(--g);color:white;text-align:center;padding:40px 5%}
.contact p{color:#d9e5da}
footer{background:#081f15;color:#cbd8ce;text-align:center;padding:20px;font-size:12px}
.sticky{position:sticky;bottom:0;background:white;padding:11px 5%;border-top:1px solid #ddd;display:flex;justify-content:space-between;align-items:center;gap:10px;z-index:5}
.sticky small{color:var(--muted)}
@media(max-width:760px){.products{grid-template-columns:repeat(2,minmax(0,1fr))}.hero{grid-template-columns:1fr}.art{min-height:150px}.hero{padding-top:35px}}
@media(max-width:360px){.products{grid-template-columns:1fr}header{align-items:flex-start;flex-direction:column}}
</style>
</head>
<body>
<header>
 <div class="logo">OWOYEMI <span>SUPER STORE</span></div>
 <nav><a href="#home">Home</a><a href="#catalogue">Drinks</a><a href="#orders">My Order</a><a href="#contact">Contact</a></nav>
</header>

<main>
<section class="hero" id="home">
 <div>
  <div class="kicker">WHOLESALE & RETAIL</div>
  <h1>Your drinks. Your choice.</h1>
  <p>Welcome to Owoyemi Super Store Ltd. Browse popular drinks, select your quantities and prepare an enquiry for wholesale or personal purchases.</p>
  <a class="btn" href="#catalogue">Explore the Catalogue ↓</a>
 </div>
 <div class="art">🥤 🧃 🍾</div>
</section>

<section id="catalogue">
 <div class="heading">
  <div class="kicker" style="color:#287047">OUR DRINKS</div>
  <h2>Find your favourite</h2>
  <p>Search by brand or product. Select the drinks and quantities you want.</p>
 </div>
 <input id="search" class="search" placeholder="🔎 Search Coca-Cola, malt, water..." autocomplete="off">
 <div class="filters" id="filters"></div>
 <div class="info"><b>Demonstration catalogue:</b> Products shown are examples of drinks commonly sold in Nigeria, not confirmed store inventory. Availability, pack sizes and prices must be confirmed with the store. All prices are enquiries only.</div>
 <div class="count" id="count"></div>
 <div class="products" id="products"></div>
 <p class="muted" style="font-size:12px">Some brands and package sizes may vary by location. This catalogue does not guarantee availability.</p>
</section>

<section id="orders">
 <div class="order">
  <h2>🛒 Your drinks enquiry</h2>
  <p class="muted">Review your selected items before sending. No payment is taken on this demo website.</p>
  <div id="cart"><p>Your list is empty. Add drinks from the catalogue above.</p></div>
  <button class="btn dark" onclick="sendOrder()">Send Enquiry on WhatsApp →</button>
  <button class="btn" onclick="clearCart()" style="margin-left:5px">Clear List</button>
 </div>
</section>

<section class="contact" id="contact">
 <div class="kicker">OWOYEMI SUPER STORE LTD.</div>
 <h2>Buying for home, a party or your shop?</h2>
 <p>Ask us about current prices, carton quantities and availability.</p>
 <button class="btn" onclick="sendOrder()">Make an Enquiry</button>
 <p style="font-size:12px">Official phone number, address and opening hours will be added after confirmation by the owner.</p>
</section>
</main>

<div class="sticky">
 <div><b>My Order</b><br><small id="summary">0 items selected</small></div>
 <a class="btn dark" href="#orders">Review Order</a>
</div>
<footer>© <span id="year"></span> Owoyemi Super Store Ltd. · Website demonstration</footer>

<script>
// Replace this demo number with the store's real WhatsApp number.
// Nigerian format: 234 followed by the phone number, without + or spaces.
const STORE_WHATSAPP = "2348000000000";

const categories = [
 ["all","All Drinks"],
 ["soft","Soft Drinks"],
 ["water","Water, Juice & Dairy"],
 ["malt","Malt & Energy"],
 ["alcohol","Alcoholic Drinks"]
];

// 100 example product options: 25 in each category.
// Pack formats are options to confirm, not a claim of store stock.
const raw = [
["Coca-Cola Original","soft","🥤","PET bottle"],
["Coca-Cola Zero Sugar","soft","🥤","Can or bottle"],
["Coca-Cola Glass Bottle","soft","🥤","Returnable bottle"],
["Fanta Orange","soft","🍊","PET bottle"],
["Fanta Orange Glass","soft","🍊","Returnable bottle"],
["Fanta Chapman","soft","🍹","Bottle or can"],
["Sprite Lemon-Lime","soft","🍋","Bottle"],
["Sprite Zero Sugar","soft","🍋","Bottle or can"],
["Pepsi Cola","soft","🥤","Bottle"],
["Pepsi Diet","soft","🥤","Can or bottle"],
["7UP","soft","🍋","Bottle"],
["Mirinda Orange","soft","🍊","Bottle"],
["Mirinda Apple","soft","🍏","Bottle, if available"],
["Schweppes Bitter Lemon","soft","🍋","Bottle or can"],
["Schweppes Chapman","soft","🍹","Bottle or can"],
["Schweppes Soda Water","soft","💧","Bottle"],
["Bigi Cola","soft","🥤","Bottle"],
["Bigi Apple","soft","🍏","Bottle"],
["Bigi Orange","soft","🍊","Bottle"],
["Bigi Lemon-Lime","soft","🍋","Bottle"],
["La Casera Apple","soft","🍏","Bottle"],
["Sosa Cola","soft","🥤","Bottle, if available"],
["Limca Lemon-Lime","soft","🍋","If available"],
["Krest Bitter Lemon","soft","🍋","If available"],
["Canada Dry Ginger Ale","soft","🥤","If available"],

["Eva Water","water","💧","Bottle or pack"],
["Aquafina Water","water","💧","Bottle or pack"],
["Nestlé Pure Life Water","water","💧","Bottle or pack"],
["Ragolis Water","water","💧","Bottle or pack"],
["CWAY Water","water","💧","Bottle or pack"],
["Table Water Generic","water","💧","Confirm brand"],
["Five Alive Pulpy","water","🧃","Carton or pack"],
["Five Alive Berry Blast","water","🧃","If available"],
["Chivita 100% Orange","water","🍊","Carton"],
["Chivita Active","water","🧃","Carton"],
["Chivita Exotic","water","🥭","Carton"],
["Happy Hour Juice","water","🧃","Carton or pack"],
["D'Berry Juice","water","🍓","If available"],
["Hollandia Yoghurt","water","🥛","Bottle or pack"],
["Hollandia Evaporated Milk","water","🥛","Carton"],
["Peak Milk Drink","water","🥛","If available"],
["Loya Milk Drink","water","🥛","If available"],
["Fumman Juice","water","🧃","If available"],
["Chi Exotic","water","🥭","If available"],
["Chi Active","water","🧃","If available"],
["Chi Happy Hour","water","🧃","If available"],
["Viju Milk Drink","water","🥛","Bottle"],
["Viju Chocolate","water","🍫","Bottle"],
["Minute Maid","water","🍊","If available"],
["Tampico Juice","water","🧃","If available"],

["Maltina Original","malt","🍺","Bottle or can"],
["Maltina Classic","malt","🍺","If available"],
["Amstel Malta","malt","🥤","Bottle or can"],
["Malta Guinness","malt","🥤","Bottle or can"],
["Grand Malt","malt","🥤","Bottle or can"],
["Hi-Malt","malt","🥤","If available"],
["Bigi Malt","malt","🥤","If available"],
["Beta Malt","malt","🥤","If available"],
["33 Export Malt","malt","🥤","If available"],
["Fearless Energy Drink","malt","⚡","Can"],
["Power Horse","malt","⚡","Can"],
["Red Bull","malt","⚡","Can, if available"],
["Monster Energy","malt","⚡","Can, if available"],
["Predator Energy","malt","⚡","Can, if available"],
["Climax Energy","malt","⚡","If available"],
["Bullet Energy Drink","malt","⚡","If available"],
["Lucozade Energy","malt","⚡","Bottle"],
["Lucozade Boost","malt","⚡","If available"],
["Lucozade Sport","malt","🏃","If available"],
["Power Play Energy","malt","⚡","If available"],
["Smoov Chapman","malt","🍹","If available"],
["Smoov Flavoured Drink","malt","🍓","If available"],
["Malta Guinness Smooth","malt","🥤","If available"],
["Amstel Malta Ultra","malt","🥤","If available"],
["Malt Drink Mixed Carton","malt","📦","Confirm brands"],

["Star Lager Beer","alcohol","🍺","Bottle or can"],
["Gulder Lager Beer","alcohol","🍺","Bottle or can"],
["Heineken Lager","alcohol","🍺","Bottle or can"],
["33 Export Lager","alcohol","🍺","Bottle or can"],
["Hero Lager","alcohol","🍺","Bottle or can"],
["Life Lager","alcohol","🍺","Bottle or can"],
["Trophy Lager","alcohol","🍺","Bottle or can"],
["Legend Extra Stout","alcohol","🍺","Bottle or can"],
["Guinness Foreign Extra Stout","alcohol","🍺","Bottle or can"],
["Guinness Smooth","alcohol","🍺","If available"],
["Smirnoff Ice","alcohol","🍹","Bottle or can"],
["Desperados","alcohol","🍺","If available"],
["Budweiser","alcohol","🍺","If available"],
["Corona Extra","alcohol","🍺","If available"],
["Tiger Beer","alcohol","🍺","If available"],
["Orijin Bitters","alcohol","🍾","Bottle, if available"],
["Orijin Herbal Drink","alcohol","🍾","If available"],
["Action Bitters","alcohol","🍾","If available"],
["Chelsea Dry Gin","alcohol","🍾","If available"],
["Gordon's Gin","alcohol","🍸","If available"],
["Jameson Irish Whiskey","alcohol","🥃","If available"],
["Johnnie Walker Red Label","alcohol","🥃","If available"],
["William Lawson's Whisky","alcohol","🥃","If available"],
["Carlo Rossi Wine","alcohol","🍷","If available"],
["Four Cousins Wine","alcohol","🍷","If available"]
];

const products = raw.map((r,i)=>({
 id:i+1,name:r[0],cat:r[1],emoji:r[2],pack:r[3]
}));
const cart = {};
let active = "all";

const productBox = document.getElementById("products");
const filtersBox = document.getElementById("filters");

categories.forEach(([key,label])=>{
 const b=document.createElement("button");
 b.className="filter"+(key==="all"?" active":"");
 b.textContent=label;
 b.onclick=()=>{
  active=key;
  document.querySelectorAll(".filter").forEach(x=>x.classList.remove("active"));
  b.classList.add("active");
  render();
 };
 filtersBox.appendChild(b);
});

function render(){
 const term=document.getElementById("search").value.trim().toLowerCase();
 const shown=products.filter(p=>
  (active==="all"||p.cat===active)&&
  (p.name.toLowerCase().includes(term)||p.pack.toLowerCase().includes(term))
 );
 document.getElementById("count").textContent=
  shown.length+" product options shown";
 productBox.innerHTML="";
 shown.forEach(p=>{
  const card=document.createElement("article");
  card.className="card";
  const pic=document.createElement("div");
  pic.className="pic";pic.textContent=p.emoji;
  const d=document.createElement("div");d.className="details";
  const h=document.createElement("h3");h.textContent=p.name;
  const desc=document.createElement("p");desc.textContent=p.pack;
  const price=document.createElement("div");price.className="price";price.textContent="Ask for price";
  const qty=document.createElement("select");qty.className="qty";
  qty.id="qty"+p.id;
  for(let n=1;n<=100;n++){
   const o=document.createElement("option");o.value=n;
   o.textContent="Quantity: "+n;o.selected=n===(cart[p.id]||1);
   qty.appendChild(o);
  }
  const btn=document.createElement("button");btn.className="btn dark";
  btn.textContent=cart[p.id]?"Update quantity":"Add to enquiry";
  btn.onclick=()=>{
   cart[p.id]=Number(qty.value);
   btn.textContent="Added ✓";
   updateCart();
  };
  d.append(h,desc,price,qty,btn);card.append(pic,d);productBox.appendChild(card);
 });
}
document.getElementById("search").addEventListener("input",render);

function updateCart(){
 const selected=products.filter(p=>cart[p.id]);
 const total=selected.reduce((s,p)=>s+cart[p.id],0);
 document.getElementById("summary").textContent=
  total+" item(s) across "+selected.length+" product(s)";
 const box=document.getElementById("cart");
 if(!selected.length){
  box.innerHTML="<p>Your list is empty. Add drinks from the catalogue above.</p>";
  return;
 }
 box.innerHTML="";
 const ul=document.createElement("ul");ul.className="cartlist";
 selected.forEach(p=>{
  const li=document.createElement("li");
  li.textContent=p.name+" × "+cart[p.id];
  ul.appendChild(li);
 });
 const note=document.createElement("p");
 note.className="muted";
 note.textContent="Prices and availability will be confirmed by the store.";
 box.append(ul,note);
}

function clearCart(){
 Object.keys(cart).forEach(k=>delete cart[k]);
 render();updateCart();
}

function sendOrder(){
 const selected=products.filter(p=>cart[p.id]);
 let message="Hello Owoyemi Super Store Ltd. I would like to enquire about your drinks.\n\n";
 if(selected.length){
  message+="My requested items:\n";
  selected.forEach(p=>message+="- "+p.name+" x "+cart[p.id]+"\n");
 }else{
  message+="Please send me your current drinks catalogue and prices.";
 }
 message+="\nPlease confirm stock, pack sizes, prices and delivery/pickup options. Thank you.";
 if(STORE_WHATSAPP==="2348000000000"){
  alert("Demo website: WhatsApp is not connected yet. Ask the owner for the real business number before enabling orders.");
  return;
 }
 window.open("https://wa.me/"+STORE_WHATSAPP+"?text="+encodeURIComponent(message),"_blank");
}

document.getElementById("year").textContent=new Date().getFullYear();
render();
updateCart();
</script>
</body>
</html>
